"""benchmark.py - measures TCP vs UDP round-trip time, throughput and loss."""
import socket, time, statistics, sys

IP, N = "127.0.0.1", 200

def tcp_test(size):
    msg = "x" * size
    t0 = time.perf_counter()
    s = socket.socket(); s.connect((IP, 5000))
    setup = (time.perf_counter() - t0) * 1000
    rtts, ok = [], 0
    for i in range(N):
        t = time.perf_counter()
        s.sendall(f"bench|{i}|{msg}".encode())
        r = s.recv(2048)
        rtts.append((time.perf_counter() - t) * 1000); ok += 1
    s.close()
    return setup, rtts, ok

def udp_test(size):
    msg = "x" * size
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(0.05)
    rtts, ok = [], 0
    for i in range(N):
        t = time.perf_counter()
        s.sendto(f"bench|{i}|{msg}".encode(), (IP, 5001))
        try:
            s.recvfrom(2048)
            rtts.append((time.perf_counter() - t) * 1000); ok += 1
        except socket.timeout:
            pass
    s.close()
    return 0.0, rtts, ok

print(f"{'Proto':<6}{'Payload':>8}{'Setup ms':>10}{'Avg ms':>9}{'Min ms':>9}{'Max ms':>9}{'Delivered':>11}{'Loss %':>8}")
for size in (64, 512):
    for name, fn in (("TCP", tcp_test), ("UDP", udp_test)):
        setup, rtts, ok = fn(size)
        print(f"{name:<6}{size:>8}{setup:>10.3f}{statistics.mean(rtts):>9.3f}{min(rtts):>9.3f}{max(rtts):>9.3f}{ok:>6}/{N:<4}{(N-ok)/N*100:>8.1f}")


